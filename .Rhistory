merge(productos, by.x = "k", by.y = "code", all.x = TRUE) |>
group_by(hs4) |>
slice_max(valor_mundial, n = 1, with_ties = FALSE) |>
select(hs4, descripcion_hs4 = description) |>
as.data.table()
